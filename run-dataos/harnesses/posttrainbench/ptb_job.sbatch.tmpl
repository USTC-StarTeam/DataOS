#!/bin/bash
# PostTrainBench per-(base, bench) train+generate+score job — rendered + submitted by
# dataos_auto.h100_slurm. Account-compliant (hcgu): files under /data/hcgu/users/tjh,
# UNIFIED conda from /data/software/miniconda3 + SHARED envs under /data/hcgu/.conda/envs
# (never the home miniconda3, which is being retired). Reuses hcgu's pipeline:
# prepare_pool_data (fixed pool) -> train_sft (LoRA, merged to final_model) ->
# run_posttrainbench_protocol_eval (vLLM generation + native scoring). Judge benches
# generate here; the API judge runs on the login node (dataos_auto.judge), never in Slurm.
#SBATCH --job-name=ptb_@BENCH@
#SBATCH --partition=gpu
#SBATCH --qos=gpu_priv
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=@TIME_LIMIT@
#SBATCH --output=@RUN_ROOT@/logs/slurm_%j.out
#SBATCH --error=@RUN_ROOT@/logs/slurm_%j.err
set -eo pipefail

RUN_ROOT="@RUN_ROOT@"
BASE_MODEL="@BASE_MODEL@"
AGENTVER="/data/hcgu/users/tjh/dataos_agentver"
HARNESS="$AGENTVER/run-dataos/harnesses/posttrainbench"
# Eval code + data are VENDORED in-branch (run-dataos/eval) so the eval is fully
# self-contained and aligned with the official PostTrainBench scorers — no dependence
# on external /data/hcgu/{projects,hlv,posttrainbench_benchmarks} checkouts.
EVAL_ROOT="$AGENTVER/run-dataos/eval"
EVAL_RT="$EVAL_ROOT/dataos_lmeval"
PTB_SRC="$EVAL_ROOT/posttrainbench_src"
BENCHMARKS="$EVAL_ROOT/benchmarks"
INSPECT_PKGS="$EVAL_ROOT/inspect_pkgs"

mkdir -p "$RUN_ROOT/data" "$RUN_ROOT/adapter" "$RUN_ROOT/final_model" \
         "$RUN_ROOT/status" "$RUN_ROOT/logs" "$RUN_ROOT/eval"

# Model/tokenizer scratch cache stays on shared scratch; the eval DATASETS (gpqa,
# humaneval, aime, gsm8k) resolve OFFLINE from the vendored HF cache under benchmarks/,
# and gpqa's dynamic loading script from the vendored modules cache.
export HF_HOME=/data/hcgu/hf_cache
export TRANSFORMERS_CACHE=/data/hcgu/hf_cache
export HF_DATASETS_CACHE="$BENCHMARKS/hf_datasets"
export HF_MODULES_CACHE="$BENCHMARKS/modules"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false

source /data/software/miniconda3/etc/profile.d/conda.sh
cd "$RUN_ROOT"

echo "[job] prepare data $(date)"
conda activate /data/hcgu/.conda/envs/train
python "$HARNESS/prepare_pool_data.py" \
  --benchmark-tag @BENCHMARK_TAG@ --sources "@SOURCES@" --mix "@MIX@" \
  --n-samples @N_SAMPLES@ --out "$RUN_ROOT/data/sft" 2>&1 | tee "$RUN_ROOT/logs/prepare.log"

echo "[job] train $(date)"
python "$HARNESS/train_sft.py" \
  --base-model "$BASE_MODEL" --data-dir "$RUN_ROOT/data/sft" \
  --output-dir "$RUN_ROOT/adapter" --merged-dir "$RUN_ROOT/final_model" \
  --max-len @MAX_LEN@ --bs @BS@ --grad-accum @GRAD_ACCUM@ \
  --lr @LR@ --epochs @EPOCHS@ --lora-r @LORA_R@ --lora-alpha @LORA_ALPHA@ \
  2>&1 | tee "$RUN_ROOT/logs/train.log"
echo "$RUN_ROOT/final_model" > "$RUN_ROOT/final_model/model_path.txt"

echo "[job] generate+score task=@BENCH@ limit=@EVAL_LIMIT@ $(date)"
EVAL_DIR="$RUN_ROOT/eval/@BENCH@_limit@EVAL_LIMIT@"
mkdir -p "$EVAL_DIR"
conda activate /data/hcgu/.conda/envs/lm-eval   # puts the env (python3.12 + vllm) on PATH
python "$EVAL_RT/scripts/run_posttrainbench_protocol_eval.py" \
  --task @BENCH@ --model-path "$RUN_ROOT/final_model" --model-name "ptb_@BENCH@" \
  --output-dir "$EVAL_DIR" --posttrainbench-eval-src "$PTB_SRC" \
  --benchmarks-dir "$BENCHMARKS" --inspect-pkgs "$INSPECT_PKGS" \
  --python "$(command -v python)" --limit @EVAL_LIMIT@ \
  2>&1 | tee "$RUN_ROOT/logs/eval.log" || echo "[job] eval step rc=$? (judge benches scored on login node)"

echo "[job] DONE $(date)"
