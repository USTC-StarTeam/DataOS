{
  "goal": "<one sentence: which model, which bench, which pool, within which budget>",
  "workspace": "workspace/<run-id>",
  "environment": "PTB_H100_slurm",
  "task": "posttrainbench",
  "bench": "<gsm8k | humaneval | gpqamain | aime2025 | arenahardwriting | healthbench | bfcl>",

  "inputs": {
    "base_model_path": "<absolute path on the exec host>",
    "fixed_pool": "/data2/hcgu/dataos_fixed_pools/processed/posttrainbench_fixed_pool_v2"
  },

  "exec": {
    "deploy_root": "/data2/hcgu/dataos_exp",
    "runs_base": "/data2/hcgu/dataos_agentver_runs",
    "resource": {
      "gpus": 1,
      "cpus": 8,
      "node": null,
      "qos": "gpu_priv"
    }
  },

  "budget": {
    "time_hours": 10,
    "eval_samples": -2
  },

  "agent": {
    "provider": "codex",
    "model": "gpt-5.6-sol",
    "effort": "medium"
  },

  "monitor_port": 8791
}
